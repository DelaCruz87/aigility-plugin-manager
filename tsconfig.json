{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "paths": {
      "aigility-types": ["./src/integrated/types.ts"]
    },
    "lib": ["DOM", "ES2022"]
  },
  "files": [
    "main.ts",
    "src/integrated/types.ts"
  ],
  "exclude": ["node_modules"]
}
