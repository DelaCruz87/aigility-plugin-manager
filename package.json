{
  "name": "aigility-plugin-manager",
  "version": "0.1.1",
  "description": "Integrated plugin manager for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck -p tsconfig.json && node esbuild.config.mjs production",
    "test": "node --test tests/*.test.mjs tests/*check.mjs",
    "test:foundation": "node --test tests/foundation.test.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin-manager"
  ],
  "author": "AIgility",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "latest",
    "obsidian": "latest",
    "typescript": "latest"
  }
}
